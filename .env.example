# APIMETEO — configuração local sem Docker.
# A API local usa 3100; no Render, a variável PORT fornecida pela plataforma tem prioridade.
API_PORT=3100

# Não coloque chaves privadas no código React.

# A página de referência exibida pelo professor informa "Dados atualizados pela Open-Meteo".
# Endpoint oficial documentado da Open-Meteo Forecast API (sem chave para uso público).
APIMETEO_WEATHER_URL_TEMPLATE=https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,pressure_msl,wind_speed_10m,wind_direction_10m&hourly=temperature_2m,precipitation_probability,weather_code,uv_index,visibility&daily=weather_code,temperature_2m_min,temperature_2m_max,precipitation_probability_max,sunrise,sunset&temperature_unit=celsius&wind_speed_unit=kmh&timezone=auto&forecast_days=5

# Open-Meteo público não exige chave nem cabeçalho de autenticação.
APIMETEO_API_KEY=
APIMETEO_AUTH_HEADER=Authorization
APIMETEO_AUTH_PREFIX=Bearer
# Alternativa caso a documentação exija chave na query string:
APIMETEO_API_KEY_QUERY_PARAM=
# Informe somente se a documentação exigir timezone na requisição.
APIMETEO_REQUEST_TIMEZONE=

# Mapeamento confirmado pela estrutura JSON da Open-Meteo Forecast API.
# O adaptador converte os códigos WMO de weather_code em descrições em português.
APIMETEO_PATH_TEMPERATURE=current.temperature_2m
APIMETEO_PATH_CONDITION=current.weather_code
APIMETEO_PATH_FEELS_LIKE=current.apparent_temperature
APIMETEO_PATH_HUMIDITY=current.relative_humidity_2m
APIMETEO_PATH_WIND_SPEED=current.wind_speed_10m
APIMETEO_PATH_WIND_DIRECTION=current.wind_direction_10m
APIMETEO_PATH_PRESSURE=current.pressure_msl
APIMETEO_PATH_UV_INDEX=hourly.uv_index
APIMETEO_PATH_AIR_QUALITY=
APIMETEO_PATH_VISIBILITY=hourly.visibility
APIMETEO_PATH_PRECIPITATION=current.precipitation
APIMETEO_PATH_MIN_TEMPERATURE=daily.temperature_2m_min.0
APIMETEO_PATH_MAX_TEMPERATURE=daily.temperature_2m_max.0
APIMETEO_PATH_SUNRISE=daily.sunrise.0
APIMETEO_PATH_SUNSET=daily.sunset.0
APIMETEO_PATH_TIMEZONE=timezone

# Previsão horária: cada caminho aponta para um array da resposta.
# O servidor começa no horário atual, em vez de exibir a primeira hora da madrugada.
APIMETEO_PATH_HOURLY_TIME=hourly.time
APIMETEO_PATH_HOURLY_TEMPERATURE=hourly.temperature_2m
APIMETEO_PATH_HOURLY_CONDITION=hourly.weather_code
APIMETEO_PATH_HOURLY_PRECIPITATION_PROBABILITY=hourly.precipitation_probability

# Previsão diária: cinco dias para a tela e para o comparador.
APIMETEO_PATH_DAILY_DATE=daily.time
APIMETEO_PATH_DAILY_MIN_TEMPERATURE=daily.temperature_2m_min
APIMETEO_PATH_DAILY_MAX_TEMPERATURE=daily.temperature_2m_max
APIMETEO_PATH_DAILY_CONDITION=daily.weather_code
APIMETEO_PATH_DAILY_PRECIPITATION_PROBABILITY=daily.precipitation_probability_max

# A busca de cidades usa o endpoint oficial de geocodificação Open-Meteo.
# Desenvolvimento local: a API usa a porta 3100 e o Vite encaminha /api para ela.
# Em produção, defina VITE_API_BASE_URL somente no Vercel com a URL pública do Render.
VITE_API_BASE_URL=
