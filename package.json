{
  "name": "apimeteo-immersive",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,CLIENT \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "nodemon server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/locationService.js && node --check server/weatherService.js && node --check server/weatherAdapter.js && node --check scripts/test-api.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.7",
    "vite": "^6.0.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
